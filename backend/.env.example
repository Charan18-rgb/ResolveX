# ResolveX Backend Environment Configuration
# Copy this file to .env and fill in your actual values. Never commit .env!

APP_NAME="ResolveX Backend"
APP_ENV="development"
DEBUG=true

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15

# SQLite Database
DATABASE_PATH=resolvex.db

# Conversation Limits
MAX_CLARIFICATION_TURNS=3

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
